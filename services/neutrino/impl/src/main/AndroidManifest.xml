<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for ConnectivityManager network callbacks (ConnectivityKicker). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Required to hold a WifiManager.MulticastLock. Android's Wi-Fi driver
         drops incoming multicast not addressed to this device, which switches
         off the mDNS peer discovery the mesh uses over Wi-Fi. A normal
         permission: granted at install, with no runtime prompt. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
</manifest>
